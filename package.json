{
  "name": "@fadhelmurphy/next-devtools",
  "version": "0.3.0",
  "description": "Nuxt DevTools-style developer panel for Next.js 10+: component inspector with click-to-open-in-editor, component tree (incl. Server Components), routes, packages, config, payload, network, assets and Web Vitals. App Router and Pages Router, Turbopack and webpack.",
  "license": "MIT",
  "author": "Fadhel Ijlal Falah",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fadhelmurphy/next-devtools.git"
  },
  "keywords": [
    "nextjs",
    "next",
    "devtools",
    "inspector",
    "react",
    "open-in-editor",
    "app-router",
    "pages-router"
  ],
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "client",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "import": "./dist/client/index.js",
      "require": "./dist/client/index.cjs",
      "default": "./dist/client/index.js"
    },
    "./loader": "./dist/loader.cjs",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup && tsc -p tsconfig.client.json",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.client.json",
    "test": "vitest run",
    "prepublishOnly": "npm run build && npm test",
    "check:dist": "npm run build && git diff --exit-code --stat -- dist"
  },
  "peerDependencies": {
    "next": ">=10.0.0",
    "react": ">=17.0.0",
    "react-dom": ">=17.0.0"
  },
  "dependencies": {
    "@babel/parser": "^7.29.0",
    "launch-editor": "^2.14.0",
    "magic-string": "^0.30.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tsup": "^8.5.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=14.18"
  },
  "bin": {
    "next-devtools": "./dist/cli.cjs"
  },
  "typesVersions": {
    "*": {
      "client": [
        "./dist/client/index.d.ts"
      ]
    }
  }
}
